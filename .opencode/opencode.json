{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "$HOME/.config/gh/*": "allow",
      "*/@fission-ai/openspec/*": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium"]
    }
  }
}
