# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date.
# Each ignore is pinned to the exact assessed vulnerable version (`* > pkg@version`) so only that
# occurrence is suppressed — a different version of the same package (potentially fixable) stays visible.
# Spring Framework 6.2.x / Spring Security 6.5.x: fixed only in Spring Framework 7.0.9 and
# Spring Security 7.0.7, which requires the deferred Spring Boot 4 migration (see ADR-0004).
# Short-term expires so the scheduled scan re-surfaces these if the migration has not landed.
ignore:
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267072:
    - '* > org.springframework:spring-beans@6.2.19':
        reason: Spring Boot 4 migration deferred; fix requires Spring Framework 7.0.9 (ADR-0004)
        expires: 2026-11-28T00:00:00.000Z
        created: 2026-08-28T00:00:00.000Z
  SNYK-JAVA-ORGSPRINGFRAMEWORK-19267073:
